# Banco local — não é necessário configurar Supabase.
# Os dados ficam em: data/inaja.sqlite e data/uploads/
# Basta rodar: npm run dev   ou   rodar.bat

# Backup automático (0 desativa). Exemplo: a cada 24 horas, mantendo 30 cópias.
BACKUP_AUTO_HOURS=24
BACKUP_RETAIN_COUNT=30

# Logs estruturados no terminal. Use debug somente durante investigação.
LOG_LEVEL=info
LOG_SLOW_REQUEST_MS=1000
LOG_STACK=1

# E-mail SMTP (opcional). Preencha para ativar notificações por e-mail.
GD_EMAIL_FROM=
GD_SMTP_HOST=
GD_SMTP_PORT=587
GD_SMTP_USER=
GD_SMTP_PASS=

# MCP da Prefeitura: as chaves são geradas no sistema, em MCP (admin).
# Localmente, a URL de conexão é http://localhost:8001/mcp; externamente, use HTTPS.
# Informe uma origem somente se um cliente MCP em navegador exigir CORS.
MCP_ALLOWED_ORIGIN=

# O servidor local escuta apenas na máquina por padrão. Use 0.0.0.0 somente
# atrás de HTTPS/VPN/proxy reverso com controle de acesso.
INAJA_BIND_HOST=127.0.0.1

# Cookie de sessao: Secure automatico se a requisicao for HTTPS (ou X-Forwarded-Proto=https).
# Force com 1/true atras de HTTPS; use 0/false se estiver em HTTP puro sem TLS (ex.: IP:porta na VPS).
INAJA_COOKIE_SECURE=

# Deploy atual na VPS (acesso direto por IP): INAJA_BIND_HOST=0.0.0.0 na porta 8001.
# Prefira Traefik/HTTPS e bind 127.0.0.1 quando o proxy estiver na frente.

# Autentique API v2. Gere a chave no painel da Autentique e mantenha-a somente no servidor.
AUTENTIQUE_API_TOKEN=
AUTENTIQUE_WEBHOOK_SECRET=

# Portal da Transparência (cadastre-se em https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email)
PORTAL_TRANSPARENCIA_API_KEY=

# Detector de Atos (serviço local sob demanda iniciado por npm run dev:integrado).
# A IA é sempre a mesma configurada em Admin > Configurações; nenhuma chave é duplicada aqui.
DETECTOR_ATOS_URL=http://127.0.0.1:8010
DETECTOR_ATOS_PORT=8010
DETECTOR_ATOS_USER=
DETECTOR_ATOS_PASSWORD=

# Bot Telegram (notificações, consultas financeiras, contratos e backups)
# Crie o bot no Telegram conversando com o @BotFather (https://t.me/BotFather) com o comando /newbot
# Pode ser informado aqui ou diretamente no painel web (Admin > Configurações > Bot Telegram).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ENABLED=1

